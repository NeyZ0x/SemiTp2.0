end)

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.LeftShift and not speedEnabled then
        speedEnabled = true
        speedToggleButton.Text = "SPEED : ON"
        speedToggleButton.BackgroundColor3 = C_SPEED_ON
        enableSpeedBypass()
    end
end)

UserInputService.InputEnded:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.LeftShift and speedEnabled then
        speedEnabled = false
        speedToggleButton.Text = "SPEED : OFF"
        speedToggleButton.BackgroundColor3 = C_SPEED_OFF
        disableSpeedBypass()
    end
end)

