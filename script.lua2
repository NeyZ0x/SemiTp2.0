local sts = Instance.new("UIStroke", speedToggleButton)
sts.Color = C_ACCENT sts.Thickness = 1 sts.Transparency = 0.3

speedToggleButton.MouseButton1Click:Connect(function()
    speedEnabled = not speedEnabled
    if speedEnabled then
        speedToggleButton.Text = "SPEED : ON"
        speedToggleButton.BackgroundColor3 = C_SPEED_ON
        enableSpeedBypass()
    else
        speedToggleButton.Text = "SPEED : OFF"
        speedToggleButton.BackgroundColor3 = C_SPEED_OFF
        disableSpeedBypass()
    end
end)

